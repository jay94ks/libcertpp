{
    "version": 4,
    "configurations": [
        {
            "name": "Windows",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/third-party"
            ],

            "defines": [
                "__COMPILES_LIBCERTPP__=1",
                "__SHARED_LIBCERTPP__=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "msvc-x64"
        },
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/third-party"
            ],

            "defines": [
                "__COMPILES_LIBCERTPP__=1",
                "__SHARED_LIBCERTPP__=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}